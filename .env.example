# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.

# Banco
DB_NAME=devmetrics
DB_USER=devmetrics
DB_PASSWORD=troque-esta-senha
DB_PORT=5433

# Perfil Spring: dev ou prod
SPRING_PROFILES_ACTIVE=dev

# Segredos da aplicacao
# JWT_SECRET: minimo 32 caracteres
JWT_SECRET=troque-esta-chave-em-producao-com-no-minimo-32-bytes
# TOKEN_ENCRYPTION_KEY: exatamente 32 caracteres (AES-256)
TOKEN_ENCRYPTION_KEY=devmetrics-chave-aes-local-32ch!

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:8080/api/v1/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/github/callback

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Webhook do GitHub (opcional): mesmo segredo configurado no webhook do repositorio
# Payload URL: http://<seu-host>/api/v1/github/webhook  ·  Content type: application/json  ·  evento: push
GITHUB_WEBHOOK_SECRET=

# Conta demo com um ano de dados de exemplo (botao "Ver demo" no login, perfil /u/demo)
DEMO_ENABLED=true

# Claude (opcional): reescreve o Desafio de Hoje para a stack do usuario
ANTHROPIC_API_KEY=
